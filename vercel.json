{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "api": {
      "root": "api",
      "framework": "flask"
    },
    "backend": {
      "root": "backend",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
